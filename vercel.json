{
  "version": 2,
  "builds": [
    {
      "src": "bot.py",
      "use": "@vercel/python",
      "config": { "wsgiOptions": { "app": "flask_app" } }
    }
  ],
  "routes": [
    {
      "src": "/api/bot-webhook",
      "dest": "bot.py"
    },
    {
      "src": "/(.*)",
      "dest": "bot.py"
    }
  ]
}
